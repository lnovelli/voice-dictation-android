<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Pulsing ring (shown during recording) -->
    <View
        android:id="@+id/pulseRing"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_overlay_recording"
        android:visibility="gone" />

    <!-- Main button circle -->
    <FrameLayout
        android:id="@+id/btnOverlayCircle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_overlay_idle"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/ivOverlayIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            app:tint="#FFFFFFFF"
            android:contentDescription="Dictate" />

        <ProgressBar
            android:id="@+id/pbOverlayProcessing"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
