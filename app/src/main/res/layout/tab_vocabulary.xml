<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <!-- Add Word Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vocabulary_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vocabulary_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWordInput"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/add_word_hint"
                app:boxStrokeColor="@color/accent"
                app:hintTextColor="@color/accent"
                android:layout_marginEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNewWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddWord"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/btn_add"
                android:backgroundTint="@color/primary"
                app:icon="@drawable/ic_add" />
        </LinearLayout>
    </LinearLayout>

    <!-- Final transcript formatting and polishing gates. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transcript_formatting_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchStaticNumericCorrections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/static_numeric_corrections_toggle"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/static_numeric_corrections_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvPolishingMinimumWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPolishingMinimumWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="20"
            android:stepSize="1"
            android:value="10"
            android:contentDescription="@string/polishing_minimum_words_label"
            app:thumbColor="@color/accent"
            app:trackColorActive="@color/accent"
            app:trackColorInactive="@color/surface_variant_dark" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPolishingAutoNumberSequences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/polishing_auto_number_sequences_toggle"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/polishing_auto_number_sequences_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Experimental acoustic context controls; disabled by default. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/acoustic_vocabulary_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAcousticVocabulary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/acoustic_vocabulary_toggle"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvAcousticVocabularyWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/acoustic_vocabulary_warning"
            android:textColor="@color/warning"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvMaxActivePaths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMaxActivePaths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="2"
            android:valueTo="8"
            android:stepSize="1"
            android:value="4"
            android:contentDescription="@string/max_active_paths_label"
            app:thumbColor="@color/accent"
            app:trackColorActive="@color/accent"
            app:trackColorInactive="@color/surface_variant_dark" />

        <TextView
            android:id="@+id/tvHotwordsScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderHotwordsScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1.0"
            android:valueTo="5.0"
            android:stepSize="0.1"
            android:value="1.0"
            android:contentDescription="@string/hotwords_score_label"
            app:thumbColor="@color/accent"
            app:trackColorActive="@color/accent"
            app:trackColorInactive="@color/surface_variant_dark" />
    </LinearLayout>

    <!-- Vocabulary List Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tvVocabularyCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Custom Terms (0)"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvClearVocabulary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear All"
            android:textColor="@color/recording_red"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp" />
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVocabulary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="16dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyVocabulary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="160dp"
        android:gravity="center"
        android:text="@string/empty_vocabulary"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:padding="24dp"
        android:visibility="gone" />

    <!-- Literal post-transcript replacements, separate from acoustic word boosting. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/string_replacement_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/string_replacement_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddStringReplacement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/string_replacement_add"
            android:backgroundTint="@color/primary"
            app:icon="@drawable/ic_add" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tvStringReplacementCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/string_replacement_count"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvClearStringReplacements"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/string_replacement_clear_action"
            android:textColor="@color/recording_red"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStringReplacements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvEmptyStringReplacements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:gravity="center"
        android:text="@string/string_replacement_empty"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:padding="24dp"
        android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
